# ==============================================================================
# CẤU HÌNH TẬP TRUNG CHO HỆ THỐNG VIETNAM LEGAL RAG (.env.example)
# Hãy đổi tên file này thành .env và điền API Key của bạn.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API KEYS & BASE ENDPOINTS
# ------------------------------------------------------------------------------
# OpenRouter API Key (Dùng để gọi các mô hình LLM trên đám mây & fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google AI Studio / Gemini API Key (Dùng cho QueryRouter, Rewrite, HyDE, Decompose & LLM chính)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_REST_URL=https://generativelanguage.googleapis.com/v1beta

# ------------------------------------------------------------------------------
# 2. CHỌN MÔ HÌNH LLM (TẠO CÂU TRẢ LỜI & SUY LUẬN)
# ------------------------------------------------------------------------------
# Mô hình Gemini chính: gemini-2.5-flash, gemini-flash-latest, gemini-flash-lite-latest
GEMINI_MODEL=gemini-2.5-flash

# Danh sách mô hình Gemini dự phòng (tự động chuyển khi model chính chạm giới hạn HTTP 429):
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-2.5-flash-lite

# Mô hình OpenRouter chính: openrouter/free, openai/gpt-4o-mini, deepseek/deepseek-chat
OPENROUTER_MODEL=openrouter/free

# Mô hình OpenRouter dự phòng cấp 2:
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Siêu tham số sinh văn bản của LLM
TEMPERATURE=0.0
MAX_TOKENS=8192
LLM_TIMEOUT=45
ROUTER_TIMEOUT=15

# ------------------------------------------------------------------------------
# 3. MÔ HÌNH EMBEDDING (VECTOR HÓA VĂN BẢN)
# ------------------------------------------------------------------------------
# Mặc định sử dụng BAAI/bge-m3 (Chạy hoàn toàn cục bộ/local 100% offline, miễn phí, không tốn API)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------------------------
# 4. MÔ HÌNH RERANKER (TÁI XẾP HẠNG TÀI LIỆU TRUY XUẤT)
# ------------------------------------------------------------------------------
# Mặc định: AITeamVN/Vietnamese_Reranker (Mô hình Cross-Encoder tiếng Việt chạy cục bộ trên CPU/GPU)
RERANKER_MODEL=AITeamVN/Vietnamese_Reranker
# Độ dài token tối đa cho Local Vietnamese Reranker (512 giúp suy luận nhanh gấp 4 lần trên CPU)
RERANKER_MAX_LENGTH=512
RERANKER_TIMEOUT=25

# ------------------------------------------------------------------------------
# 5. SIÊU THAM SỐ TRUY XUẤT TWO-STAGE HYBRID (RETRIEVAL HYPERPARAMETERS)
# ------------------------------------------------------------------------------
# Số lượng tài liệu ứng viên lọc thô qua kết hợp BM25 + Dense Vector bằng công thức RRF:
CANDIDATE_K=15
# Hằng số làm mượt mẫu số trong công thức RRF (Reciprocal Rank Fusion):
RRF_K=40
# Số lượng tài liệu tinh túy nhất giữ lại sau bước Cross-Encoder Rerank để đưa vào LLM:
RERANK_TOP_K=5
BASELINE_RETRIEVE_K=5

# ------------------------------------------------------------------------------
# 6. PHÂN ĐOẠN VĂN BẢN PHÁP LUẬT (LEGAL CHUNKING)
# ------------------------------------------------------------------------------
# Độ dài tối đa của một chunk Điều/Khoản luật (ký tự):
LEGAL_CHUNK_MAX_SIZE=1400
# Độ dài tối thiểu của một chunk:
LEGAL_CHUNK_MIN_SIZE=80

# ------------------------------------------------------------------------------
# 7. ĐƯỜNG DẪN DỮ LIỆU & LƯU TRỮ CHỈ MỤC (STORAGE PATHS)
# ------------------------------------------------------------------------------
DATA_DIR=./ducument
PERSIST_DIR=./chroma_data
TESTSET_PATH=./data/benchmark_testset_50.json
CHROMA_COLLECTION_NAME=vietnamese_docs

# ------------------------------------------------------------------------------
# 8. THAM SỐ HỆ THỐNG & ĐÁNH GIÁ (SYSTEM & BENCHMARK EVALUATION)
# ------------------------------------------------------------------------------
SEED=42
BATCH_SIZE=16
EVAL_MAX_WORKERS=2
EVAL_TIMEOUT=180
EVAL_MAX_RETRIES=2
EVAL_MAX_WAIT=60
EVAL_STRICTNESS=1

# ------------------------------------------------------------------------------
# 9. CẤU HÌNH WEB SERVER & BẢO MẬT FASTAPI (APP SERVER)
# ------------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
